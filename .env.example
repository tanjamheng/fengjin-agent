# 环境变量配置
# 复制为 .env 并填入真实值

# 风堇主模型（OpenAI 兼容接口）
FENGJIN_API_KEY=your-api-key-here
FENGJIN_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FENGJIN_MODEL=glm-5.1

# 记忆辅助模型（OpenAI 兼容接口）
MEMO_API_KEY=your-api-key-here
MEMO_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEMO_MODEL=glm-4.5-air

# P1 安全模型开关（true=启用 Llama Guard 语义检测, false=仅用 P0 规则引擎）
# 关闭后不会下载/加载/运行 Llama Guard 模型，可节省 ~2GB 显存和 ~7s 启动时间
FENGJIN_GUARD_MODEL_ENABLED=false

# 日志级别（可选）
LOG_LEVEL=INFO
