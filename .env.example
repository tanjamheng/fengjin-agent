# 环境变量配置
# 复制为 .env 并填入真实值

# 风堇主模型（OpenAI 兼容接口）
FENGJIN_API_KEY=
FENGJIN_BASE_URL=
FENGJIN_MODEL=

# 记忆辅助模型（OpenAI 兼容接口）
MEMO_API_KEY=
MEMO_BASE_URL=
MEMO_MODEL=

# 长期记忆开关（默认关闭；开启但未配置记忆模型时会跳过记忆功能）
MEMORY_ENABLED=false

# P1 安全模型开关（true=启用 Llama Guard 语义检测, false=仅用 P0 规则引擎）
# 关闭后不会下载/加载/运行 Llama Guard 模型，可节省 ~2GB 显存和 ~7s 启动时间
# 默认 false：个人本地使用更轻量；需要更强语义安全护栏时改为 true
FENGJIN_GUARD_MODEL_ENABLED=false

# 日志级别（可选）
LOG_LEVEL=INFO
