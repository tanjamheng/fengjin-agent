# 环境变量配置
# 复制为 .env 并填入真实值

# 风堇主模型（OpenAI 兼容接口）
FENGJIN_API_KEY=
FENGJIN_BASE_URL=
FENGJIN_MODEL=

# 心智模型：记忆提取 + 情绪羁绊分析（OpenAI 兼容接口）
MIND_API_KEY=
MIND_BASE_URL=
MIND_MODEL=

# 心智总开关（默认关闭；同时控制记忆、情绪和羁绊）
MIND_ENABLED=false

# P1 安全模型开关（true=启用 Llama Guard 语义检测, false=仅用 P0 规则引擎）
# 关闭后不会下载/加载/运行 Llama Guard 模型，可节省 ~2GB 显存和 ~7s 启动时间
# 默认 false：个人本地使用更轻量；需要更强语义安全护栏时改为 true
FENGJIN_GUARD_MODEL_ENABLED=false

# 日志级别（可选）
LOG_LEVEL=INFO
